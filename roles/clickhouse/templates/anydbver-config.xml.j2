<clickhouse>
  <!-- Written by anydbver. Peers reach this node by IP: the container
       hostname does not resolve from the other containers. -->
  <listen_host>0.0.0.0</listen_host>
  <listen_host>::1</listen_host>
  <!-- Containers often have IPv6 disabled: skip ::1 instead of failing. -->
  <listen_try>1</listen_try>
  <interserver_http_host>{{ clickhouse_node_ip }}</interserver_http_host>

  <macros>
    <cluster>{{ cluster_name | e }}</cluster>
    <shard>{{ clickhouse_shard | e }}</shard>
    <replica>{{ ansible_hostname }}</replica>
  </macros>
{% for k in clickhouse_keepers if k.ip == clickhouse_node_ip %}

  <!-- This node is Keeper member {{ clickhouse_keepers.index(k) + 1 }} of {{ clickhouse_keepers | length }}. -->
  <keeper_server>
    <tcp_port>9181</tcp_port>
    <server_id>{{ clickhouse_keepers.index(k) + 1 }}</server_id>
    <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
    <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
    <raft_configuration>
{% for m in clickhouse_keepers %}
      <server>
        <id>{{ loop.index }}</id>
        <hostname>{{ m.ip }}</hostname>
        <port>9234</port>
      </server>
{% endfor %}
    </raft_configuration>
  </keeper_server>
{% endfor %}

  <zookeeper>
{% for m in clickhouse_keepers %}
    <node>
      <host>{{ m.ip }}</host>
      <port>9181</port>
    </node>
{% endfor %}
  </zookeeper>

  <!-- Every ClickHouse node sharing this Keeper, grouped by shard.
       internal_replication: a Distributed table writes each row to one
       replica and ReplicatedMergeTree copies it to the others. -->
  <remote_servers>
    <{{ cluster_name }}>
{% for shard, replicas in clickhouse_members | groupby('shard') %}
      <shard>
        <internal_replication>true</internal_replication>
{% for r in replicas %}
        <replica>
          <host>{{ r.ip }}</host>
          <port>9000</port>
          <user>{{ clickhouse_user | e }}</user>
          <password>{{ db_password | e }}</password>
        </replica>
{% endfor %}
      </shard>
{% endfor %}
    </{{ cluster_name }}>
  </remote_servers>
</clickhouse>
